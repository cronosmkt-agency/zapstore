# ============================================================
# ZapStore — Variáveis de Ambiente & Configurações de Produção
# ============================================================

# URL base oficial da plataforma (usado para sitemap, canonical links e redirects)
VITE_APP_URL="https://zapstore-mu.vercel.app"

# Modo da aplicação
VITE_APP_ENV="production"

# Configuração Cloudflare / Workers (opcional se gerenciado via dashboard)
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""

# Gateway de Pagamentos (quando ativar pagamentos reais no Asaas / Stripe)
# ASAAS_API_KEY=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Banco de Dados Supabase (quando migrar do mockDb)
# VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY=""
